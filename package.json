{
  "name": "bugbear",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "bin": {
    "bugbear": "bin.js"
  },
  "exports": {
    "./package": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "package.json",
    "index.js",
    "index.d.ts",
    "bin.js",
    "lib/"
  ],
  "imports": {
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    },
    "process": {
      "bare": "bare-process",
      "default": "process"
    }
  },
  "scripts": {
    "format": "prettier . --write",
    "test": "brittle-bare test/index.js",
    "lint": "prettier . --check && lunte"
  },
  "keywords": [
    "debug",
    "events",
    "bare"
  ],
  "author": "Dominic Cassidy",
  "license": "Apache-2.0",
  "dependencies": {
    "bare-fs": "^4.7.1",
    "bare-path": "^3.0.0",
    "bare-process": "^4.4.1",
    "paparam": "^1.10.1",
    "z32": "^1.1.0"
  },
  "devDependencies": {
    "brittle": "^3.19.1",
    "lunte": "^1.8.0",
    "prettier": "^3.8.3",
    "prettier-config-holepunch": "^2.0.0"
  }
}
